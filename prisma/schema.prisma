// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider   = "prisma-client-js"
  engineType = "library"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum OrderStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum TopupStatus {
  PENDING
  APPROVED
  REJECTED
}

enum CouponType {
  PERCENT
  FIXED
}

enum StockStatus {
  AVAILABLE
  SOLD
  RESERVED
}

enum StoreStatus {
  ACTIVE
  EXPIRED
  SUSPENDED
}

model User {
  id            Int                @id @default(autoincrement())
  name          String?
  username      String?            @unique
  email         String?            @unique
  password      String?
  emailVerified DateTime?
  image         String?
  balance       Float              @default(0)
  points        Int                @default(0)
  role          Role               @default(USER)
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  accounts      Account[]
  sessions      Session[]
  orders        Order[]
  topups        TopupTransaction[]
  pointsHistory PointsHistory[]
  couponUsage   CouponUsage[]
  tenantStores  TenantStore[]
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model TenantStore {
  id                 String       @id @default(uuid())
  slug               String       @unique
  name               String
  description        String?      @db.Text
  logo               String?
  banner             String?
  primaryColor       String       @default("#0284c7")
  accentColor        String       @default("#0369a1")
  paymentPromptPay   String?
  paymentBankName    String?
  paymentAccountNo   String?
  paymentAccountName String?
  paymentQrImage     String?
  profitMargin       Float        @default(100)
  ownerId            Int
  status             StoreStatus  @default(ACTIVE)
  monthlyRentPoints  Int          @default(300)
  expiresAt          DateTime
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  owner              User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  products           Product[]
  categories         Category[]
  orders             Order[]

  @@index([ownerId])
}

model Category {
  id            String       @id @default(uuid())
  name          String
  icon          String?
  order         Int          @default(0)
  tenantStoreId String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  tenantStore   TenantStore? @relation(fields: [tenantStoreId], references: [id], onDelete: Cascade)
  products      Product[]

  @@index([tenantStoreId])
}

model Product {
  id            String         @id @default(uuid())
  name          String
  description   String         @db.Text
  price         Float
  discount      Float?         @default(0)
  image         String?
  isUnlimited   Boolean        @default(false)
  pointsEarn    Int            @default(0)
  isHot         Boolean        @default(false)
  badge         String?
  isActive      Boolean        @default(true)
  downloadUrl   String?        @db.Text
  tenantStoreId String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  categoryId    String

  category      Category       @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  tenantStore   TenantStore?   @relation(fields: [tenantStoreId], references: [id], onDelete: Cascade)
  orders        Order[]
  productStock  ProductStock[]

  @@index([tenantStoreId])
  @@index([categoryId])
}

model ProductStock {
  id           String      @id @default(uuid())
  productId    String
  accountEmail String
  accountPass  String
  accountData  String?     @db.Text
  status       StockStatus @default(AVAILABLE)
  orderId      Int?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  product      Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  order        Order?      @relation(fields: [orderId], references: [id], onDelete: SetNull)

  @@index([productId, status])
}

model Order {
  id            Int            @id @default(autoincrement())
  userId        Int
  productId     String
  productName   String
  productImage  String?
  price         Float
  quantity      Int            @default(1)
  totalPrice    Float
  pointsEarned  Int            @default(0)
  pointsUsed    Int            @default(0)
  couponId      String?
  couponDiscount Float         @default(0)
  tenantStoreId String?
  status        OrderStatus    @default(PENDING)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  tenantStore   TenantStore?   @relation(fields: [tenantStoreId], references: [id], onDelete: Cascade)
  productStock  ProductStock[]

  @@index([tenantStoreId])
}

model TopupTransaction {
  id          Int         @id @default(autoincrement())
  userId      Int
  amount      Float
  pointsEarned Int        @default(0)
  slipImage   String?
  status      TopupStatus @default(PENDING)
  approvedAt  DateTime?
  rejectedAt  DateTime?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model PointsHistory {
  id          String   @id @default(uuid())
  userId      Int
  amount      Int
  type        String
  description String
  createdAt   DateTime @default(now())
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Coupon {
  id          String        @id @default(uuid())
  code        String        @unique
  type        CouponType    @default(PERCENT)
  value       Float
  minPurchase Float         @default(0)
  maxDiscount Float?
  usageLimit  Int?
  usedCount   Int           @default(0)
  startDate   DateTime      @default(now())
  endDate     DateTime?
  isActive    Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  usage       CouponUsage[]
}

model CouponUsage {
  id        String   @id @default(uuid())
  userId    Int
  couponId  String
  orderId   Int?
  usedAt    DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  coupon    Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)

  @@unique([userId, couponId])
}
